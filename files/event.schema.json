{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "type": "object",
  "required": ["client_event_id", "event_type", "source_bus", "timestamp", "latitude", "longitude", "gps_source", "confidence", "severity"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^EVT_"},
    "client_event_id": {"type": "string"},
    "event_type": {"type": "string", "enum": ["pothole","vehicle_car","vehicle_bus","vehicle_truck","vehicle_motorcycle","traffic_sign","traffic_light","road_divider","zebra_crossing","waterlogging","pedestrian","streetlight"]},
    "source_bus": {"type": "string", "pattern": "^BUS_"},
    "route_id": {"type": ["string", "null"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "gps_source": {"type": "string", "enum": ["simulated", "real"]},
    "gps_accuracy_m": {"type": ["number", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "tracking_id": {"type": ["string", "null"]},
    "road_segment_id": {"type": ["string", "null"]},
    "frame_ref": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["OPEN","ACKNOWLEDGED","IN_PROGRESS","RESOLVED","PENDING_VERIFICATION","VERIFIED","DISPUTED","RE_ESCALATED"]},
    "incident_id": {"type": ["string", "null"]},
    "metadata": {"type": ["object", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
